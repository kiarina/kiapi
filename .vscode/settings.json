{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.associations": {
    ".mise/tasks/*": "shellscript",
    ".mise/tasks/**/*": "shellscript",
    "format": "shellscript",
    "version": "shellscript"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.coverage": true,
    "**/coverage.xml": true
  }
}
