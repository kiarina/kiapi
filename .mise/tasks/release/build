#!/usr/bin/env bash
#MISE description="Build the release artifacts after checking the version"
#USAGE arg "<version>" help="Release version (e.g. '0.3.0')"

set -euo pipefail

version="$usage_version"
project_version="$(awk -F'"' '/^version = "/ { print $2; exit }' pyproject.toml)"

if [ "$project_version" != "$version" ]; then
    echo "❌ pyproject.toml version $project_version does not match release version $version" >&2
    exit 1
fi

rm -rf dist
mise run web:build
echo "🏗️  Building kiapi $version..."
uv build --out-dir dist
echo "✅ Release artifacts built in dist/"
