#!/usr/bin/env bash
#MISE description="Clean build/cache artifacts"

set -euo pipefail

echo "🧹 Cleaning artifacts..."
rm -rf dist build .mypy_cache .pytest_cache .ruff_cache
rm -rf src/kiapi/api/ui/static
rm -f .coverage .coverage.* coverage.xml
for dir in src tests scripts; do
    find "$dir" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    find "$dir" -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete 2>/dev/null || true
done
find src -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true
