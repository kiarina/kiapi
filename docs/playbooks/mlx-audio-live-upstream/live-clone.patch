index 0000000000000000000000000000000000000000..d9d848dea299eef7bb70ebdc3a3c2bb7e448db18
--- /dev/null
+++ b/mlx_audio/tts/models/qwen3_tts/live.py
@@ -0,0 +1,445 @@
+"""Experimental Base-only, span-local live voice cloning.
+
+This explicit reference-end/target-start layout is opt-in, not an official
+Qwen input protocol. Spans restart from the reference, not preceding output.
+All model operations must run serially on the thread that prepared the clone.
+"""
+
+import copy
+import math
+import threading
+import time
+import weakref
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import mlx.core as mx
+
+from mlx_audio.tts.models.base import GenerationResult
+from mlx_audio.utils import load_audio
+
+from .live_text import TextSource
+
+_LOCK_INIT = threading.Lock()
+
+
+def _clone(value):
+    if isinstance(value, mx.array):
+        return mx.array(value)
+    if isinstance(value, list):
+        return [_clone(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(_clone(item) for item in value)
+    if isinstance(value, dict):
+        return {key: _clone(item) for key, item in value.items()}
+    if hasattr(value, "state"):
+        cloned = copy.copy(value)
+        cloned.state = _clone(value.state)
+        return cloned
+    return copy.copy(value)
+
+
+def _lock(model):
+    with _LOCK_INIT:
+        lock = getattr(model, "_live_clone_lock", None)
+        if lock is None:
+            lock = threading.Lock()
+            model._live_clone_lock = lock
+            model._live_clone_thread = threading.get_ident()
+        if model._live_clone_thread != threading.get_ident():
+            raise RuntimeError("Live model operations must stay on one worker thread")
+    if not lock.acquire(blocking=False):
+        raise RuntimeError("Another live preparation/generator owns this model")
+    return lock
+
+
+def _base_only(model):
+    if model.config.tts_model_type != "base":
+        raise ValueError("Live cloning supports Qwen3-TTS Base only")
+    if model.tokenizer is None or model.speech_tokenizer is None:
+        raise ValueError("Tokenizer and speech tokenizer must be loaded")
+    if not model.speech_tokenizer.has_encoder or model.speaker_encoder is None:
+        raise ValueError("Live cloning requires reference and speaker encoders")
+
+
+def _embed(model, ids):
+    return model.talker.text_projection(
+        model.talker.get_text_embeddings()(mx.array([ids]))
+    )
+
+
+def _decoder_state(decoder):
+    # decoder can be an mx.compile wrapper: named_modules exposes the real root.
+    return {
+        name: {
+            key: _clone(getattr(module, key))
+            for key in ("_buffer", "_overflow", "_transformer_cache")
+            if hasattr(module, key)
+        }
+        for name, module in decoder.named_modules()
+    }
+
+
+@dataclass(frozen=True)
+class PreparedLiveClone:
+    """Opaque reusable snapshot belonging to one model instance and worker thread.
+
+    Do not modify its private arrays/cache or use it after replacing model
+    weights/tokenizers. Call release() on its worker when it is no longer needed.
+    """
+
+    language: str
+    sample_rate: int
+    reference_samples: int
+    _owner: object = field(repr=False)
+    _thread: int = field(repr=False)
+    _snapshot: dict = field(repr=False)
+
+    @property
+    def required_prefix_tokens(self):
+        return 1
+
+    def _check(self, model):
+        if self._owner() is not model:
+            raise ValueError("Prepared clone belongs to a different model")
+        if self._thread != threading.get_ident():
+            raise RuntimeError("Use the same worker thread that prepared the clone")
+        if not self._snapshot:
+            raise RuntimeError("Prepared clone has been released")
+
+    def release(self):
+        if self._thread != threading.get_ident():
+            raise RuntimeError("Release the snapshot on its model worker thread")
+        model = self._owner()
+        if model is None:
+            self._snapshot.clear()
+            return
+        lock = _lock(model)
+        try:
+            self._snapshot.clear()
+        finally:
+            lock.release()
+
+
+def prepare_live_clone(model, ref_audio, ref_text, lang_code="auto"):
+    _base_only(model)
+    if not isinstance(ref_text, str) or not ref_text.strip():
+        raise ValueError("A nonempty reference transcript is required")
+    if not isinstance(lang_code, str) or not lang_code.strip():
+        raise ValueError("lang_code must be a language name or auto")
+    language = lang_code.lower()
+    languages = model.config.talker_config.codec_language_id or {}
+    if language != "auto" and language not in languages:
+        raise ValueError(f"Unsupported language: {lang_code}")
+    lock = _lock(model)
+    decoder = model.speech_tokenizer.decoder
+    try:
+        if isinstance(ref_audio, Path):
+            ref_audio = str(ref_audio)
+        audio = load_audio(ref_audio, sample_rate=model.sample_rate)
+        if audio.ndim != 1 or audio.size == 0:
+            raise ValueError("Reference audio must be a nonempty mono waveform")
+        if not mx.issubdtype(audio.dtype, mx.floating):
+            raise TypeError("Reference waveform must be floating-point audio")
+        if not bool(mx.all(mx.isfinite(audio))):
+            raise ValueError("Reference audio must be finite")
+        # Base's existing serial builder supplies role/language/full-ref speaker.
+        # Remove only its empty-text EOS/codec-PAD and text-PAD/codec-BOS rows.
+        serial, _, pad = model._prepare_generation_inputs(
+            "", language=language, ref_audio=audio
+        )
+        prefix = serial[:, :-2]
+        codes = model.speech_tokenizer.encode(audio[None, None, :])
+        ref_ids = model.tokenizer.encode(
+            f"<|im_start|>assistant\n{ref_text}<|im_end|>\n"
+        )[3:-2]
+        codec = model.talker.get_input_embeddings()(codes[:, 0])
+        for index in range(model.config.talker_config.num_code_groups - 1):
+            codec = codec + model.talker.code_predictor.codec_embedding[index](
+                codes[:, index + 1]
+            )
+        config = model.config.talker_config
+        bridge = model.talker.get_input_embeddings()(mx.array([[config.codec_bos_id]]))
+        codec = mx.concatenate([bridge, codec], axis=1)
+        eos = _embed(model, [model.config.tts_eos_token_id])
+        text = mx.concatenate([_embed(model, ref_ids), eos], axis=1)
+        if text.shape[1] > codec.shape[1]:
+            raise ValueError("Reference transcript exceeds reference codec region")
+        text = mx.concatenate(
+            [
+                text,
+                mx.broadcast_to(
+                    pad, (1, codec.shape[1] - text.shape[1], text.shape[-1])
+                ),
+            ],
+            axis=1,
+        )
+        codec_eos = model.talker.get_input_embeddings()(
+            mx.array([[config.codec_eos_token_id]])
+        )
+        inputs = mx.concatenate([prefix, text + codec, pad + codec_eos, prefix], axis=1)
+        cache = model.talker.make_cache()
+        logits, hidden = model.talker(inputs, cache=cache)
+        mx.eval(logits, hidden)
+        decoder.reset_streaming_state()
+        mx.eval(decoder.streaming_step(codes))
+        saved = {
+            "cache": _clone(cache),
+            "decoder": _decoder_state(decoder),
+            "bridge": bridge,
+            "eos": eos,
+            "pad": pad,
+            "rows": inputs.shape[1],
+            "prefix": prefix,
+            "reference_codes": codes,
+        }
+        mx.eval(bridge, eos, pad)
+        return PreparedLiveClone(
+            language,
+            model.sample_rate,
+            int(audio.size),
+            weakref.ref(model),
+            threading.get_ident(),
+            saved,
+        )
+    finally:
+        try:
+            decoder.reset_streaming_state()
+        finally:
+            lock.release()
+
+
+def _fork(model, prepared):
+    saved = prepared._snapshot
+    decoder = model.speech_tokenizer.decoder
+    decoder.reset_streaming_state()
+    modules = dict(decoder.named_modules())
+    for name, values in saved["decoder"].items():
+        for key, value in values.items():
+            setattr(modules[name], key, _clone(value))
+    return _clone(saved["cache"])
+
+
+def _span(
+    model,
+    prepared,
+    text,
+    source,
+    emit_frames,
+    max_frames,
+    temperature,
+    top_k,
+    top_p,
+    repetition_penalty,
+):
+    source._check_cancel()
+    ids = model.tokenizer.encode(text, add_special_tokens=False)
+    if not ids:
+        return
+    cache = _fork(model, prepared)
+    saved = prepared._snapshot
+    inputs = _embed(model, ids[:1]) + saved["bridge"]
+    cursor = 1
+    generated = []
+    first_ids = []
+    emitted = 0
+    code_cache = model.talker.code_predictor.make_cache()
+    decoder = model.speech_tokenizer.decoder
+    eos = model.config.talker_config.codec_eos_token_id
+    suppress = model._suppress_codec_tokens(eos)
+    try:
+        for _ in range(max_frames):
+            source._check_cancel()
+            logits, hidden = model.talker(inputs, cache=cache)
+            source._check_cancel()
+            token = model._sample_token(
+                logits,
+                temperature=temperature,
+                top_k=top_k,
+                top_p=top_p,
+                repetition_penalty=repetition_penalty,
+                repetition_context_size=max(1, len(first_ids)),
+                generated_tokens=first_ids or None,
+                suppress_tokens=suppress + ([] if cursor > len(ids) else [eos]),
+            )
+            mx.eval(token)
+            if int(token[0, 0]) == eos:
+                break
+            source._check_cancel()
+            parts, codes = model._predict_code_tokens(
+                token,
+                hidden,
+                temperature=temperature,
+                top_k=top_k,
+                top_p=top_p,
+                code_cache=code_cache,
+                cancel_requested=lambda: source._cancelled,
+            )
+            mx.eval(codes)
+            first_ids.append(int(token[0, 0]))
+            generated.append(codes)
+            if len(generated) - emitted >= emit_frames:
+                source._check_cancel()
+                block = mx.transpose(mx.stack(generated[emitted:], axis=1), (0, 2, 1))
+                audio = decoder.streaming_step(block).squeeze(1)[0]
+                mx.eval(audio)
+                source._check_cancel()
+                count = len(generated) - emitted
+                emitted = len(generated)
+                yield audio, count
+            source._check_cancel()
+            next_text = (
+                _embed(model, [ids[cursor]])
+                if cursor < len(ids)
+                else (saved["eos"] if cursor == len(ids) else saved["pad"])
+            )
+            inputs = next_text + model._codec_embeds_for_tokens(parts)
+            mx.eval(inputs)
+            cursor += 1
+        else:
+            raise RuntimeError("max_frames reached before span EOS")
+        if len(generated) > emitted:
+            source._check_cancel()
+            block = mx.transpose(mx.stack(generated[emitted:], axis=1), (0, 2, 1))
+            audio = decoder.streaming_step(block).squeeze(1)[0]
+            mx.eval(audio)
+            source._check_cancel()
+            yield audio, len(generated) - emitted
+    finally:
+        decoder.reset_streaming_state()
+
+
+def generate_live(
+    model,
+    source,
+    prepared,
+    *,
+    temperature=0.9,
+    top_k=50,
+    top_p=1.0,
+    repetition_penalty=1.05,
+    emit_frames=4,
+    max_frames=1000,
+    seed=None,
+):
+    """Yield streaming PCM chunks and one empty terminal result on successful close.
+
+    Cancellation raises InterruptedError; errors/cancel/generator.close() never
+    emit a successful terminal marker. Call close() when abandoning a generator.
+    """
+    _base_only(model)
+    if not isinstance(source, TextSource) or not isinstance(
+        prepared, PreparedLiveClone
+    ):
+        raise TypeError("Expected TextSource and PreparedLiveClone")
+    prepared._check(model)
+    for name, value in (("emit_frames", emit_frames), ("max_frames", max_frames)):
+        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+            raise ValueError(f"{name} must be a positive integer")
+    if (
+        not math.isfinite(temperature)
+        or temperature < 0
+        or not 0 < top_p <= 1
+        or not math.isfinite(repetition_penalty)
+        or repetition_penalty <= 0
+    ):
+        raise ValueError("Invalid sampling controls")
+    if isinstance(top_k, bool) or not isinstance(top_k, int) or top_k < 0:
+        raise ValueError("top_k must be a nonnegative integer")
+    if seed is not None and (
+        isinstance(seed, bool)
+        or not isinstance(seed, int)
+        or not 0 <= seed <= 0xFFFFFFFFFFFFFFFF
+    ):
+        raise ValueError("seed must be an unsigned 64-bit integer or None")
+    lock = _lock(model)
+    claimed = False
+    decoder = model.speech_tokenizer.decoder
+    started = time.perf_counter()
+    total_samples = total_frames = cursor = span_index = 0
+    try:
+        source._claim()
+        claimed = True
+        if seed is not None:
+            mx.random.seed(seed)
+        while True:
+            text, cursor = source._next_span(cursor, prepared.language)
+            if text is None:
+                break
+            if not text.strip():
+                continue
+            chunks = _span(
+                model,
+                prepared,
+                text,
+                source,
+                emit_frames,
+                min(500, max_frames - total_frames),
+                temperature,
+                top_k,
+                top_p,
+                repetition_penalty,
+            )
+            try:
+                for audio, frames in chunks:
+                    source._check_cancel()
+                    total_samples += audio.shape[0]
+                    total_frames += frames
+                    yield _result(
+                        audio,
+                        model.sample_rate,
+                        span_index,
+                        frames,
+                        started,
+                        total_samples,
+                        total_frames,
+                        False,
+                    )
+            finally:
+                chunks.close()
+            span_index += 1
+        source._check_cancel()
+        terminal = _result(
+            mx.zeros((0,), mx.float32),
+            model.sample_rate,
+            max(0, span_index - 1),
+            0,
+            started,
+            total_samples,
+            total_frames,
+            True,
+        )
+    except BaseException:
+        if claimed:
+            source.cancel()
+        raise
+    finally:
+        try:
+            decoder.reset_streaming_state()
+        finally:
+            if claimed:
+                source._release()
+            lock.release()
+    # The final marker does not retain the model lock if a consumer stops here.
+    yield terminal
+
+
+def _result(audio, rate, segment, frames, started, samples, total_frames, final):
+    from .qwen3_tts import format_duration
+
+    elapsed = time.perf_counter() - started
+    return GenerationResult(
+        audio=audio,
+        samples=int(audio.shape[0]),
+        sample_rate=rate,
+        segment_idx=segment,
+        token_count=frames,
+        audio_duration=format_duration(audio.shape[0] / rate),
+        real_time_factor=samples / rate / elapsed if elapsed else 0.0,
+        prompt={"tokens": 0},
+        audio_samples={"samples": samples, "tokens": total_frames},
+        processing_time_seconds=elapsed,
+        peak_memory_usage=mx.get_peak_memory() / 1e9,
+        is_streaming_chunk=True,
+        is_final_chunk=final,
+    )
