+"""CPU-only live protocol tests; no weights, downloads, playback or GPU inference."""
+
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import mlx.core as mx
+import numpy as np
+import pytest
+
+from mlx_audio.tts.models.qwen3_tts import TextSource
+from mlx_audio.tts.models.qwen3_tts.live import generate_live, prepare_live_clone
+from mlx_audio.tts.models.qwen3_tts.live_text import _boundary
+from mlx_audio.tts.models.qwen3_tts.qwen3_tts import Model
+
+
+@pytest.fixture(autouse=True)
+def cpu():
+    previous = mx.default_device()
+    mx.set_default_device(mx.cpu)
+    yield
+    mx.set_default_device(previous)
+
+
+class Cache:
+    def __init__(self):
+        self.state = [0]
+
+
+class Embedding:
+    def __call__(self, ids):
+        return mx.repeat(ids[..., None].astype(mx.float32), 2, axis=-1)
+
+
+class Decoder:
+    def __init__(self):
+        self._buffer = None
+        self._overflow = None
+        self._transformer_cache = None
+
+    def reset_streaming_state(self):
+        self._buffer = self._overflow = self._transformer_cache = None
+
+    def named_modules(self):
+        return [("", self)]
+
+    def streaming_step(self, codes):
+        self._buffer = mx.array([codes.shape[-1]])
+        self._overflow = mx.array([0.0])
+        self._transformer_cache = [Cache()]
+        return mx.ones((1, 1, codes.shape[-1] * 2))
+
+
+class CompiledDecoder:
+    __slots__ = ("inner",)
+
+    def __init__(self):
+        self.inner = Decoder()
+
+    def named_modules(self):
+        return self.inner.named_modules()
+
+    def reset_streaming_state(self):
+        return self.inner.reset_streaming_state()
+
+    def streaming_step(self, codes):
+        return self.inner.streaming_step(codes)
+
+
+class Tokenizer:
+    def encode(self, text, **kwargs):
+        if text.startswith("<|im_start|>"):
+            content = text.split("\n", 1)[1].split("<|im_end|>")[0]
+            return [0, 0, 0] + [1] * len(content) + [0, 0]
+        return [1] * len(text)
+
+
+class Talker:
+    def __init__(self):
+        self.code_predictor = SimpleNamespace(
+            codec_embedding=[Embedding()], make_cache=lambda: [Cache()]
+        )
+        self.text_projection = lambda value: value
+
+    def get_text_embeddings(self):
+        return Embedding()
+
+    def get_input_embeddings(self):
+        return Embedding()
+
+    def make_cache(self):
+        return [Cache()]
+
+    def __call__(self, inputs, cache):
+        cache[0].state[0] += inputs.shape[1]
+        return mx.zeros((1, 1, 10)), mx.zeros((1, 1, 2))
+
+
+class FakeModel:
+    def __init__(self):
+        self.config = SimpleNamespace(
+            tts_model_type="base",
+            tts_eos_token_id=7,
+            talker_config=SimpleNamespace(
+                num_code_groups=2,
+                codec_bos_id=5,
+                codec_eos_token_id=9,
+                codec_language_id={"japanese": 1, "english": 2},
+            ),
+        )
+        self.tokenizer = Tokenizer()
+        self.talker = Talker()
+        self.speaker_encoder = object()
+        self.sample_rate = 24000
+        self.prepare_count = 0
+        self.controls = []
+        self.speech_tokenizer = SimpleNamespace(
+            has_encoder=True,
+            decoder=CompiledDecoder(),
+            encode=lambda audio: mx.ones((1, 2, 16), mx.int32),
+        )
+
+    def _prepare_generation_inputs(self, text, **kwargs):
+        self.prepare_count += 1
+        return mx.zeros((1, 7, 2)), None, mx.zeros((1, 1, 2))
+
+    def _suppress_codec_tokens(self, eos):
+        return []
+
+    def _sample_token(self, logits, **kwargs):
+        self.controls.append(kwargs)
+        return mx.array([[1 if 9 in kwargs["suppress_tokens"] else 9]])
+
+    def _predict_code_tokens(self, token, hidden, **kwargs):
+        if kwargs["cancel_requested"]():
+            raise InterruptedError("cancel")
+        return [token, token], mx.concatenate([token, token], axis=1)
+
+    def _codec_embeds_for_tokens(self, parts):
+        return mx.zeros((1, 1, 2))
+
+
+def setup():
+    model = FakeModel()
+    prepared = prepare_live_clone(model, mx.ones((32,)), "ref", "japanese")
+    return model, prepared
+
+
+def closed(text):
+    source = TextSource()
+    source.push(text)
+    source.close()
+    return source
+
+
+def test_prepared_independent_spans_and_accounting():
+    model, prepared = setup()
+    text = "今日はとても良い天気ですね。明日も楽しみです。"
+    first = list(generate_live(model, closed(text), prepared, emit_frames=4))
+    second = list(generate_live(model, closed(text), prepared, emit_frames=4))
+    assert model.prepare_count == 1
+    assert len({part.segment_idx for part in first if part.samples}) == 2
+    assert sum(part.is_final_chunk for part in first) == 1
+    assert first[-1].is_final_chunk and first[-1].samples == first[-1].token_count == 0
+    assert sum(part.samples for part in first) == first[-1].audio_samples["samples"]
+    assert sum(part.token_count for part in first) == first[-1].audio_samples["tokens"]
+    assert all(part.samples == part.audio.shape[0] for part in first)
+    np.testing.assert_array_equal(
+        np.concatenate([np.array(p.audio) for p in first]),
+        np.concatenate([np.array(p.audio) for p in second]),
+    )
+    assert prepared._snapshot["cache"][0].state[0] == prepared._snapshot["rows"]
+
+
+def test_empty_tiny_and_terminal_releases_lock():
+    model, prepared = setup()
+    empty = generate_live(model, closed("  "), prepared)
+    assert next(empty).is_final_chunk
+    # Stopping at final does not hold a model lock.
+    assert list(generate_live(model, closed("はい"), prepared))[-1].is_final_chunk
+    empty.close()
+
+
+def test_live_controls_do_not_override_other_paths():
+    model, prepared = setup()
+    list(
+        generate_live(
+            model,
+            closed("はい"),
+            prepared,
+            temperature=0.3,
+            top_k=4,
+            top_p=0.8,
+            repetition_penalty=1.1,
+        )
+    )
+    assert all(
+        x["temperature"] == 0.3
+        and x["top_k"] == 4
+        and x["top_p"] == 0.8
+        and x["repetition_penalty"] == 1.1
+        for x in model.controls
+    )
+    assert model.controls[0]["repetition_context_size"] == 1
+
+
+def test_cancel_during_closed_inner_span_and_consumer_close():
+    model, prepared = setup()
+    source = closed("今日はとても良い天気ですね。")
+    stream = generate_live(model, source, prepared, emit_frames=1)
+    assert next(stream).samples
+    source.cancel()
+    with pytest.raises(InterruptedError):
+        next(stream)
+    assert list(generate_live(model, closed("次"), prepared))[-1].is_final_chunk
+    source = closed("今日はとても良い天気ですね。")
+    stream = generate_live(model, source, prepared, emit_frames=1)
+    next(stream)
+    stream.close()
+    assert source._cancelled
+    assert model.speech_tokenizer.decoder.inner._transformer_cache is None
+
+
+def test_reentry_model_ownership_and_release():
+    model, prepared = setup()
+    first = generate_live(
+        model, closed("今日はとても良い天気ですね。"), prepared, emit_frames=1
+    )
+    next(first)
+    with pytest.raises(RuntimeError):
+        next(generate_live(model, closed("次"), prepared))
+    with pytest.raises(RuntimeError):
+        prepare_live_clone(model, mx.ones((32,)), "ref", "japanese")
+    with pytest.raises(RuntimeError):
+        prepared.release()
+    with pytest.raises(ValueError):
+        next(generate_live(FakeModel(), closed("次"), prepared))
+    first.close()
+    errors = []
+
+    def other_thread():
+        try:
+            next(generate_live(model, closed("次"), prepared))
+        except Exception as exc:
+            errors.append(exc)
+
+    thread = threading.Thread(target=other_thread)
+    thread.start()
+    thread.join()
+    assert isinstance(errors[0], RuntimeError)
+    prepared.release()
+    prepared.release()
+    with pytest.raises(RuntimeError):
+        next(generate_live(model, closed("次"), prepared))
+
+
+def test_source_limits_cancel_wait_timeout_and_late_input():
+    source = TextSource(max_chars=3, idle_timeout=0.01)
+    source.feed("あ")
+    with pytest.raises(ValueError):
+        source.push("あいう")
+    with pytest.raises(TimeoutError):
+        source._next_span(0, "japanese")
+    source.close()
+    assert source._next_span(0, "japanese") == ("あ", 1)
+    with pytest.raises(ValueError):
+        source.push("い")
+    source = TextSource()
+    stopped = threading.Event()
+
+    def wait():
+        with pytest.raises(InterruptedError):
+            source._next_span(0, "japanese")
+        stopped.set()
+
+    thread = threading.Thread(target=wait)
+    thread.start()
+    source.cancel()
+    assert stopped.wait(0.5)
+    thread.join()
+
+
+def test_boundaries_mixed_script_decimal_and_space():
+    assert _boundary("Tokyo is a busy city with quiet", "japanese", False) == len(
+        "Tokyo is a busy city with "
+    )
+    assert _boundary("あ" * 25, "english", False) == 24
+    assert _boundary("The value is 3.14", "english", False) == 0
+    assert _boundary("The value is 3.", "english", False) == 0
+    assert _boundary("はい", "japanese", True) == 2
+    assert _boundary("  one two three four five six ", "english", False) == len(
+        "  one two three four five six "
+    )
+
+
+def test_base_only_frame_cap_and_pre_input_cancel():
+    model, prepared = setup()
+    model.config.tts_model_type = "custom_voice"
+    with pytest.raises(ValueError):
+        prepare_live_clone(model, mx.ones((32,)), "ref")
+    model.config.tts_model_type = "base"
+    source = TextSource()
+    source.cancel()
+    with pytest.raises(InterruptedError):
+        list(generate_live(model, source, prepared))
+    with pytest.raises(RuntimeError):
+        list(generate_live(model, closed("too long"), prepared, max_frames=1))
+    assert list(generate_live(model, closed("次"), prepared))[-1].is_final_chunk
+
+
+def test_code_predictor_optional_cancel_is_noop_by_default():
+    predictor = MagicMock(return_value=(mx.zeros((1, 1, 10)), [], None))
+    predictor.codec_embedding = [Embedding()]
+    model = SimpleNamespace(
+        _reset_code_cache=lambda cache: None,
+        _sample_token_batch=lambda scores, **kwargs: mx.array([[2]]),
+        talker=SimpleNamespace(
+            code_predictor=predictor, get_input_embeddings=lambda: Embedding()
+        ),
+        config=SimpleNamespace(talker_config=SimpleNamespace(num_code_groups=2)),
+    )
+    first = mx.array([[1]])
+    hidden = mx.zeros((1, 1, 2))
+    args = dict(temperature=0.9, top_k=50, top_p=1.0, code_cache=[])
+    a = Model._predict_code_tokens(model, first, hidden, **args)
+    b = Model._predict_code_tokens(
+        model, first, hidden, cancel_requested=lambda: False, **args
+    )
+    np.testing.assert_array_equal(np.array(a[1]), np.array(b[1]))
+    assert predictor.call_count == 2
+    with pytest.raises(InterruptedError):
+        Model._predict_code_tokens(
+            model, first, hidden, cancel_requested=lambda: True, **args
+        )
+    assert predictor.call_count == 2
