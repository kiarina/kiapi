index 0000000000000000000000000000000000000000..3a28e53e2e811ea86b51443be02be9a18006b8ef
--- /dev/null
+++ b/examples/qwen3_tts_live_clone.py
@@ -0,0 +1,75 @@
+"""Experimental Base-only incremental input, writing streamed float PCM to WAV.
+
+No automatic playback. Model load/preparation/generation stay on this thread;
+only Unicode producer calls run in the background. Use your own reference and
+its exact transcript; no reference length is silently discarded.
+"""
+
+import argparse
+import threading
+
+import numpy as np
+import soundfile as sf
+
+from mlx_audio.tts.models.qwen3_tts import TextSource
+from mlx_audio.tts.utils import load_model
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--model", default="mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16"
+    )
+    parser.add_argument("--reference", required=True)
+    parser.add_argument("--reference-text", required=True)
+    parser.add_argument("--language", default="auto")
+    parser.add_argument("--output", default="live-clone.wav")
+    args = parser.parse_args()
+    model = load_model(args.model)
+    prepared = model.prepare_live_clone(
+        args.reference, args.reference_text, args.language
+    )
+    source = TextSource(max_chars=4096, idle_timeout=60)
+
+    def producer():
+        try:
+            print("Enter text fragments; an empty line closes this utterance.")
+            while True:
+                try:
+                    text = input()
+                except EOFError:
+                    break
+                if not text:
+                    break
+                source.push(text + "\n")
+            source.close()
+        except Exception:
+            source.cancel()
+
+    thread = threading.Thread(target=producer, daemon=True)
+    thread.start()
+    results = model.generate_live(source, prepared)
+    try:
+        with sf.SoundFile(
+            args.output,
+            mode="w",
+            samplerate=prepared.sample_rate,
+            channels=1,
+            subtype="FLOAT",
+        ) as output:
+            for result in results:
+                # The sole final marker has zero samples and zero token_count.
+                if result.samples:
+                    output.write(np.array(result.audio, dtype=np.float32))
+                if result.is_final_chunk:
+                    print("Complete:", result.audio_samples)
+    except KeyboardInterrupt:
+        source.cancel()
+    finally:
+        results.close()
+        source.cancel()
+        prepared.release()
+
+
+if __name__ == "__main__":
+    main()
