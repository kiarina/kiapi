@@ -0,0 +1,115 @@
+"""Bounded producer input and received-text span boundaries (no MLX operations)."""
+
+import math
+import re
+import threading
+import time
+
+_CJK = re.compile(r"[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]")
+_LATIN = re.compile(r"[A-Za-z]")
+_PUNCTUATION = re.compile(r"[、。\uff01\uff1f!?.,;:]\s*")
+
+
+def _boundary(text, language, closed):
+    cjk = bool(_CJK.search(text)) or (
+        not _LATIN.search(text) and language in {"auto", "ja", "japanese"}
+    )
+    for match in _PUNCTUATION.finditer(text):
+        index = match.start()
+        if text[index] in ".,:" and index and text[index - 1].isdigit():
+            if index + 1 < len(text) and text[index + 1].isdigit():
+                continue
+            if index + 1 == len(text) and not closed:
+                continue
+        if match.end() >= (8 if cjk else 14):
+            return match.end()
+    if cjk and len(text) >= 24:
+        return 24
+    if not cjk:
+        words = list(re.finditer(r"\S+\s+", text))
+        if len(words) >= 6:
+            return words[5].end()
+    return len(text) if closed else 0
+
+
+class TextSource:
+    """Append-only, single-utterance input. Only producers may call push/close/cancel.
+
+    Feeding never imports or executes MLX. max_chars bounds the complete input,
+    including consumed text, rather than just the currently pending fragment.
+    """
+
+    def __init__(self, max_chars=4096, idle_timeout=30.0):
+        if (
+            isinstance(max_chars, bool)
+            or not isinstance(max_chars, int)
+            or max_chars <= 0
+        ):
+            raise ValueError("max_chars must be a positive integer")
+        if not math.isfinite(idle_timeout) or idle_timeout <= 0:
+            raise ValueError("idle_timeout must be positive")
+        self.max_chars = max_chars
+        self.idle_timeout = idle_timeout
+        self._condition = threading.Condition()
+        self._text = ""
+        self._closed = False
+        self._cancelled = False
+        self._consumer = False
+
+    def push(self, text):
+        if not isinstance(text, str):
+            raise TypeError("text must be a string")
+        with self._condition:
+            if self._closed or self._cancelled:
+                raise ValueError("TextSource is no longer writable")
+            if len(self._text) + len(text) > self.max_chars:
+                raise ValueError("TextSource character budget exceeded")
+            self._text += text
+            self._condition.notify_all()
+
+    feed = push
+
+    def close(self):
+        with self._condition:
+            self._closed = True
+            self._condition.notify_all()
+
+    def cancel(self):
+        with self._condition:
+            self._cancelled = True
+            self._condition.notify_all()
+
+    def _check_cancel(self):
+        if self._cancelled:
+            raise InterruptedError("Live generation canceled")
+
+    def _claim(self):
+        with self._condition:
+            self._check_cancel()
+            if self._consumer:
+                raise RuntimeError("TextSource already has an active consumer")
+            self._consumer = True
+
+    def _release(self):
+        with self._condition:
+            self._consumer = False
+
+    def _next_span(self, cursor, language):
+        with self._condition:
+            deadline = time.monotonic() + self.idle_timeout
+            observed = len(self._text)
+            while True:
+                self._check_cancel()
+                text = self._text[cursor:]
+                length = _boundary(text, language, self._closed)
+                if length:
+                    return text[:length], cursor + length
+                if self._closed:
+                    return None, cursor
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("No complete text span; call TextSource.close()")
+                self._condition.wait(remaining)
+                if len(self._text) != observed:
+                    observed = len(self._text)
+                    deadline = time.monotonic() + self.idle_timeout
