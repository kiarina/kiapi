+def test_generate_during_prepare_is_rejected(monkeypatch):
+    model, prepared = setup()
+    original = Talker.__call__
+    attempted = []
+
+    def nested(self, inputs, cache):
+        with pytest.raises(RuntimeError):
+            next(generate_live(model, closed("next"), prepared))
+        attempted.append(True)
+        return original(self, inputs, cache)
+
+    monkeypatch.setattr(Talker, "__call__", nested)
+    second = prepare_live_clone(model, mx.ones((32,)), "ref", "japanese")
+    assert attempted
+    second.release()
